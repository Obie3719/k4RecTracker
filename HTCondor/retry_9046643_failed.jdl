Universe = vanilla

initialdir = /work/omunkombwe/k4RecTracker
executable = $(filename)

request_cpus = 1
request_memory = 10000
accounting_group = cms.higgs
request_disk = 1000000
+RequestWalltime = 4*3600

log = /work/omunkombwe/k4RecTracker/HTCondor/gun_split_submit/log/retry_9046643_$(ClusterID).log
output = /work/omunkombwe/k4RecTracker/HTCondor/gun_split_submit/out/retry_9046643_$(ClusterID)_$(ProcID).out
error = /work/omunkombwe/k4RecTracker/HTCondor/gun_split_submit/err/retry_9046643_$(ClusterID)_$(ProcID).err

queue filename from (
  /work/omunkombwe/k4RecTracker/HTCondor/gun_split_submit/theta10/submit_theta10_part97.sh
  /work/omunkombwe/k4RecTracker/HTCondor/gun_split_submit/theta46/submit_theta46_part91.sh
)
