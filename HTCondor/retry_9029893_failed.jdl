output = /work/omunkombwe/k4RecTracker/HTCondor/gun_split_submit/out/retry_9029893_$(ClusterID)_$(ProcID).out
error = /work/omunkombwe/k4RecTracker/HTCondor/gun_split_submit/err/retry_9029893_$(ClusterID)_$(ProcID).err

